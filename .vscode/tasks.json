{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Spaces: Setup workspace",
      "type": "shell",
      "command": "bash .devfile/setup-workspace.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "devspaces-setup",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^==> AUTOMATION_HOME=",
          "endsPattern": "^==> Workspace ready$"
        }
      }
    }
  ]
}
