{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Spaces: Setup workspace",
      "type": "shell",
      "command": "bash .devfile/setup-workspace.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
